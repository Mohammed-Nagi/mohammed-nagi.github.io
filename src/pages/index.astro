---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';

const GITHUB_URL = 'https://github.com/Mohammed-Nagi';
const LINKEDIN_URL = 'https://www.linkedin.com/in/mohammed-nagi-418924236/';
const EMAIL = 'mo.nagi017@gmail.com';

const projects = [
	{
		title: 'PsychRoute',
		description: 'A LinUCB contextual bandit over a fine-tuned MentalBERT classifier, routing psychiatric triage cases between model and clinician. 35% lower diagnostic error than either alone.',
		repo: `${GITHUB_URL}/psychroute`,
	},
	{
		title: 'MLAS',
		description: 'A hardware-aware alternating least squares recommender on MovieLens 32M. Numba JIT and a synchronised CSR/CSC layout cut per-epoch training from 3.5 hours to 1.46 seconds.',
		repo: `${GITHUB_URL}/MLAS`,
	},
	{
		title: 'SemEval-2026 Task 9',
		description: 'Two-stage multilingual polarisation detection under 16:1 class imbalance, using Focal Loss and dynamic per-class thresholding on DeBERTa and MARBERTv2 backbones.',
		repo: `${GITHUB_URL}/NLP`,
	},
	{
		title: 'Spectral graph theory',
		description: 'The Cross-Entropy Method extended with graph neural network policies, searching combinatorial spaces up to N=35 for counterexamples to open conjectures.',
		repo: null,
	},
];
---

<BaseLayout title="Mohammed Nagi" description="TODO: one-line site description for search engines">
	<div class="home-layout">
		<aside class="identity">
			<img
				src="/images/identity.jpg"
				width="480"
				height="480"
				alt="Mohammed Nagi"
				class="identity-photo"
			/>
			<h1>Mohammed Nagi</h1>
			<p class="tagline">MSc Artificial Intelligence, AIMS.<br />Google DeepMind Scholar.</p>
			<ul class="identity-links">
				<li>
					<a href={`mailto:${EMAIL}`} aria-label="Email">
						<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<rect x="3" y="5" width="18" height="14" rx="2" />
							<path d="m3 7 9 6 9-6" />
						</svg>
						<span>Email</span>
					</a>
				</li>
				<li>
					<a href={GITHUB_URL} aria-label="GitHub">
						<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
						</svg>
						<span>GitHub</span>
					</a>
				</li>
				<li>
					<a href={LINKEDIN_URL} aria-label="LinkedIn">
						<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<rect x="3" y="3" width="18" height="18" rx="2" />
							<path d="M7 10v7M7 7v.01M12 17v-4.5a2.5 2.5 0 0 1 5 0V17m-5-4.5V17" />
						</svg>
						<span>LinkedIn</span>
					</a>
				</li>
				<li>
					<a href="/cv.pdf" download aria-label="Download CV">
						<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M12 3v12m0 0-4-4m4 4 4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
						</svg>
						<span>CV</span>
					</a>
				</li>
			</ul>
		</aside>

		<div class="content">
			<p class="summary">I work on <strong>mechanistic interpretability</strong>, with a focus on models that encode physical signals
			rather than language. Across my work, I prioritise claims that can be <strong>falsified by intervention</strong> and I am motivated by the broader question
			of what studying intelligence in <strong>non-linguistic systems</strong> can teach us about interpretability methods built primarily on language models.</p>

			<Section id="research" title="Research">
				<article>
					<h3><a href="/research/thesis">Sparse Autoencoders on InstaNovo</a></h3>
					<p>Sparse autoencoder dictionaries trained on the residual stream activations of InstaNovo, asking which learned features correspond to which fragmentation events.</p>
					<p class="entry-links">
						<a href="/research/thesis">Writeup</a>
						<a href={`${GITHUB_URL}/instanovo-sae`}>Code</a>
					</p>
				</article>
			</Section>

			<Section id="projects" title="Projects">
				<ul class="project-list">
					{
						projects.map((project) => (
							<li>
								<h3>
									{project.repo ? <a href={project.repo}>{project.title}</a> : project.title}
								</h3>
								<p>{project.description}</p>
							</li>
						))
					}
				</ul>
			</Section>
		</div>
	</div>
</BaseLayout>

<style>
	.home-layout {
		display: flex;
		flex-direction: column;
		gap: 4rem;
		max-width: 1200px;
		margin-inline: auto;
	}

	@media (min-width: 900px) {
		.home-layout {
			flex-direction: row;
			align-items: flex-start;
		}
	}

	.identity {
		flex: 0 0 380px;
		text-align: center;
		padding: 2rem;
		background: var(--surface);
		border: 1px solid var(--rule);
		border-radius: 0.5rem;
	}

	@media (min-width: 900px) {
		.identity {
			position: sticky;
			top: 1.5rem;
		}
	}

	.identity-photo {
		width: 100%;
		max-width: 220px;
		height: auto;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		background: var(--surface);
		border-radius: 50%;
		margin-inline: auto;
	}

	.identity h1 {
		font-size: var(--step-2);
		margin-block: 1.75rem 0.25rem;
	}

	.tagline {
		color: var(--text-muted);
		margin: 0 0 2rem;
	}

	.identity-links {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.identity-links a {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		color: var(--accent);
		text-decoration: none;
		font-size: var(--step--1);
	}

	.identity-links a:hover {
		color: var(--accent-hov);
	}

	.content {
		flex: 1 1 auto;
		min-width: 0;
	}

	.summary {
		max-width: var(--measure);
	}

	.project-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.project-list h3,
	article h3 {
		margin-block: 0 0.25rem;
		font-size: var(--step-1);
	}

	.project-list h3 {
		color: var(--accent);
	}

	.project-list h3 a,
	article h3 a {
		text-decoration: none;
	}

	.project-list h3 a {
		color: inherit;
	}

	.project-list h3 a:hover,
	article h3 a:hover {
		text-decoration: underline;
	}

	.project-list p,
	article p {
		margin: 0;
		color: var(--text-muted);
	}

	.entry-links {
		display: flex;
		gap: 1.25rem;
		margin-block-start: 0.5rem;
		font-size: var(--step--1);
	}

	.entry-links a {
		color: var(--accent);
	}
</style>
