---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

const modules = import.meta.glob('/src/assets/photos/*.{jpg,webp}', { eager: true });

const pairs = new Map();
for (const [path, mod] of Object.entries(modules)) {
	const match = path.match(/(\d+)\.(jpg|webp)$/);
	if (!match) continue;
	const index = parseInt(match[1], 10);
	const entry = pairs.get(index) ?? {};
	entry[match[2]] = mod.default;
	pairs.set(index, entry);
}

const photos = Array.from(pairs.entries())
	.sort((a, b) => a[0] - b[0])
	.map(([index, { jpg, webp }]) => {
		if (!jpg || !webp) {
			throw new Error(`Missing jpg/webp pair for photo ${index}`);
		}
		return { index, jpg, webp };
	});

const CANDIDATE_WIDTHS = [400, 600, 800, 1200, 1600];
function widthsFor(intrinsicWidth: number) {
	const widths = CANDIDATE_WIDTHS.filter((w) => w < intrinsicWidth);
	widths.push(intrinsicWidth);
	return widths;
}

const sizes = '(min-width: 1000px) 33vw, (min-width: 640px) 50vw, 100vw';

const galleryPhotos = await Promise.all(
	photos.map(async (photo) => {
		const widths = widthsFor(photo.jpg.width);
		const webpImage = await getImage({ src: photo.webp, widths, format: 'webp', quality: 82 });
		const jpgImage = await getImage({ src: photo.jpg, widths, format: 'jpeg', quality: 90 });
		return { index: photo.index, webpImage, jpgImage };
	})
);
---

<BaseLayout
	title="Photography — Mohammed Nagi"
	description="A collection of photographs by Mohammed Nagi."
>
	<h1>Photography</h1>

	<div class="gallery">
		{/* alt="" is deliberate: these photos are decorative rather than
		informative, so assistive tech should skip them, not announce a
		meaningless index. Don't replace with generated placeholder text. */}
		{
			galleryPhotos.map(({ index, webpImage, jpgImage }) => (
				<button type="button" class="thumb" data-index={index}>
					<picture>
						<source srcset={webpImage.srcSet.attribute} type="image/webp" sizes={sizes} />
						<img
							src={jpgImage.src}
							srcset={jpgImage.srcSet.attribute}
							sizes={sizes}
							width={jpgImage.attributes.width}
							height={jpgImage.attributes.height}
							alt=""
							loading={index <= 3 ? undefined : 'lazy'}
							decoding="async"
							fetchpriority={index === 1 ? 'high' : undefined}
						/>
					</picture>
				</button>
			))
		}
	</div>

	<div class="lightbox" id="lightbox" hidden>
		<div class="lightbox-backdrop" data-close></div>
		<figure class="lightbox-figure" role="dialog" aria-modal="true" aria-label="Photograph viewer" tabindex="-1">
			<button type="button" class="lightbox-close" data-close aria-label="Close">×</button>
			<picture class="lightbox-picture">
				<source id="lightbox-source" type="image/webp" />
				<img id="lightbox-img" alt="" data-close />
			</picture>
		</figure>
	</div>
</BaseLayout>

<style>
	h1 {
		font-family: var(--font-serif);
		font-weight: 600;
		margin-block: 0 2rem;
		max-width: 1400px;
		margin-inline: auto;
	}

	.gallery {
		column-count: 1;
		column-gap: 1rem;
		column-fill: balance;
		max-width: 1400px;
		margin-inline: auto;
	}

	@media (min-width: 640px) {
		.gallery {
			column-count: 2;
		}
	}

	@media (min-width: 1000px) {
		.gallery {
			column-count: 3;
		}
	}

	.thumb {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: none;
		break-inside: avoid;
		margin-bottom: 1rem;
		cursor: zoom-in;
	}

	.thumb img {
		display: block;
		width: 100%;
		height: auto;
		max-height: 70vh;
		object-fit: cover;
	}

	.lightbox {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: grid;
		place-items: center;
		opacity: 0;
		transition: opacity 0.2s ease;
	}

	.lightbox[hidden] {
		display: none;
	}

	.lightbox.is-open {
		opacity: 1;
	}

	.lightbox-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.85);
	}

	.lightbox-figure {
		position: relative;
		z-index: 1;
		max-width: 92vw;
		max-height: 92vh;
		margin: 0;
		display: grid;
		place-items: center;
	}

	.lightbox-picture,
	.lightbox-picture img {
		max-width: 92vw;
		max-height: 92vh;
	}

	.lightbox-picture img {
		width: auto;
		height: auto;
		object-fit: contain;
	}

	.lightbox-close {
		position: fixed;
		top: 1rem;
		right: 1.5rem;
		z-index: 2;
		background: none;
		border: 0;
		color: #fff;
		font-size: var(--step-2);
		line-height: 1;
		cursor: pointer;
		padding: 0.25rem 0.5rem;
	}
</style>

<script>
	const lightbox = document.getElementById('lightbox') as HTMLDivElement | null;
	const lightboxSource = document.getElementById('lightbox-source') as HTMLSourceElement | null;
	const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
	const closeBtn = lightbox?.querySelector('.lightbox-close') as HTMLButtonElement | null;
	const header = document.querySelector('header');
	const gallery = document.querySelector('.gallery') as HTMLElement | null;
	const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('.thumb'));

	if (lightbox && lightboxSource && lightboxImg && closeBtn && gallery) {
		let lastTrigger: HTMLButtonElement | null = null;

		function populateFromTrigger(trigger: HTMLButtonElement) {
			const picture = trigger.querySelector('picture');
			const source = picture?.querySelector('source');
			const img = picture?.querySelector('img');
			if (!source || !img || !lightboxSource || !lightboxImg) return;

			lightboxSource.srcset = source.srcset;
			lightboxImg.srcset = img.srcset;
			lightboxImg.src = img.src;
			lightboxImg.alt = img.alt;
		}

		function openLightbox(trigger: HTMLButtonElement) {
			populateFromTrigger(trigger);
			lastTrigger = trigger;

			lightbox!.hidden = false;
			requestAnimationFrame(() => {
				lightbox!.classList.add('is-open');
			});

			if (header) (header as HTMLElement & { inert: boolean }).inert = true;
			(gallery as HTMLElement & { inert: boolean }).inert = true;

			closeBtn!.focus();
			document.addEventListener('keydown', onKeydown);
		}

		function closeLightbox() {
			lightbox!.classList.remove('is-open');
			window.setTimeout(() => {
				lightbox!.hidden = true;
			}, 200);

			if (header) (header as HTMLElement & { inert: boolean }).inert = false;
			(gallery as HTMLElement & { inert: boolean }).inert = false;

			document.removeEventListener('keydown', onKeydown);
			lastTrigger?.focus();
		}

		function navigate(direction: 1 | -1) {
			if (!lastTrigger) return;
			const currentIndex = thumbs.indexOf(lastTrigger);
			if (currentIndex === -1) return;
			const nextIndex = (currentIndex + direction + thumbs.length) % thumbs.length;
			const nextTrigger = thumbs[nextIndex];
			populateFromTrigger(nextTrigger);
			lastTrigger = nextTrigger;
		}

		function onKeydown(event: KeyboardEvent) {
			if (event.key === 'Escape') {
				closeLightbox();
			} else if (event.key === 'ArrowLeft') {
				navigate(-1);
			} else if (event.key === 'ArrowRight') {
				navigate(1);
			}
		}

		thumbs.forEach((thumb) => {
			thumb.addEventListener('click', () => openLightbox(thumb));
		});

		lightbox.querySelectorAll('[data-close]').forEach((el) => {
			el.addEventListener('click', closeLightbox);
		});
	}
</script>
